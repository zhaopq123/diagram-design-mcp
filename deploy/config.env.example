# 复制为 config.env 后填写。config.env 不要提交进仓库。
DIAGRAM_MCP_PORT=8400
DIAGRAM_MCP_BIND=0.0.0.0
DIAGRAM_MCP_TOKEN=替换成一段随机长字符串

# 会话空闲多久后回收（毫秒）。默认 30 分钟。
# 客户端大多不会发 DELETE——MCP SDK 自己的 client.close() 就不发——
# 不设这个，服务端每个会话会泄漏一个 Server + transport，长期跑必爆。
DIAGRAM_MCP_IDLE_MS=1800000

# 同时存活的会话上限，超了淘汰最久未用的。默认 256；手机内存紧可以调小。
DIAGRAM_MCP_MAX_SESSIONS=128
